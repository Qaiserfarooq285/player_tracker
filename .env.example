# Copy to .env and fill in what you have. Never commit .env (see .gitignore).
# CLAUDE.md §10: "Secrets: ask, never assume." — when a token is missing, the pipeline stops and
# asks rather than mocking data or skipping a stage silently.

# Unlocks scripts/pull_roboflow.py: pulling Roboflow Universe datasets and (per ADR-2) checking
# for an Apache-2.0 RF-DETR soccer checkpoint before falling back to COCO-pretrained.
# Phase 1 needs only this key (and HF_TOKEN below, only if a chosen model is gated).
ROBOFLOW_API_KEY=

# Unlocks downloading gated Hugging Face model weights (e.g. a gated SigLIP/RF-DETR checkpoint)
# via `transformers`/`huggingface_hub`. Only required if a specific model card is gated.
HF_TOKEN=

# Unlocks scripts/download_soccernet.py: pulling SoccerNet subsets for eval/fine-tuning data.
# Requires the SoccerNet NDA password (research/education license — CLAUDE.md §7); not needed
# for Phase 1 inference-only runs.
SOCCERNET_PASSWORD=

# Unlocks an optional Gemini VLM layer for Stage 5/6 (event sanity-check, highlight ranking) via
# API only — no local VLM (CLAUDE.md §11: an 11B vision model won't fit in 12 GB). Optional, Phase 2+.
GEMINI_API_KEY=

# Unlocks an optional TwelveLabs video-understanding API as an alternative/fallback VLM layer for
# Stage 5/6. Optional, Phase 2+.
TWELVELABS_API_KEY=
