# PitchVision always-on gateway (apps/gateway) -- installed by docker/vps/setup_vps.sh as
# /etc/systemd/system/pitchvision-gateway.service. Secrets live in /etc/pitchvision/gateway.env.
[Unit]
Description=PitchVision gateway (frontend, uploads, RunPod pod lifecycle)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pitchvision
EnvironmentFile=/etc/pitchvision/gateway.env
ExecStart=/opt/pitchvision/.venv-gateway/bin/python -m uvicorn apps.gateway.main:app --host 127.0.0.1 --port 8100 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
