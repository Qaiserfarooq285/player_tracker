# Environment variables for the RunPod pod template (docs/DEPLOY.md). Paste each as a separate
# "Environment Variable" on the template -- never commit real values.

# REQUIRED before exposing the app. Anyone with the URL can otherwise upload videos and burn credit.
PV_ACCESS_PASSWORD=choose-a-long-password

# Optional: from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token. Maps your
# Hostinger domain (e.g. app.yourdomain.com) to this pod over HTTPS with no open ports.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: same keys as .env.example; Gemini is only used by the celebration/key-moment stage.
GEMINI_API_KEY=

# Advanced (defaults are fine):
# PORT=8000
# PV_BRANCH=master
# PV_AUTO_UPDATE=1
