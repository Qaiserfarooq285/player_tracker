# Environment variables for the RunPod pod template (docs/DEPLOY.md). Paste each as a separate
# "Environment Variable" on the template -- never commit real values.

# The login gate is ON BY DEFAULT even if you leave this unset -- the built-in password below is
# the default (apps/api/access.py). Change it before exposing the app publicly.
PV_ACCESS_PASSWORD=admin1122

# Optional: enables idle auto-stop (docs/DEPLOY.md "Idle auto-stop") -- the pod stops itself after
# PV_IDLE_STOP_MINUTES of no requests and no running job, so you stop paying without having to
# remember to press Stop. Create one at RunPod -> Settings -> API Keys -> Create API Key ->
# Restricted, with the "pods" permission set to read/write. Leave blank to disable.
RUNPOD_API_KEY=
# RUNPOD_POD_ID is injected automatically by RunPod into every pod -- do not set it here.
PV_IDLE_STOP_MINUTES=30

# Optional: from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token. Maps your
# Hostinger domain (e.g. app.yourdomain.com) to this pod over HTTPS with no open ports.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: same keys as .env.example; Gemini is only used by the celebration/key-moment stage.
GEMINI_API_KEY=

# Advanced (defaults are fine):
# PORT=8000
# PV_BRANCH=master
# PV_AUTO_UPDATE=1
